# EditorConfig for ShelfOps
root = true

[*]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,xaml,csproj,sln,props,json,yml,yaml,ps1,md}]
indent_size = 4

[*.{xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false